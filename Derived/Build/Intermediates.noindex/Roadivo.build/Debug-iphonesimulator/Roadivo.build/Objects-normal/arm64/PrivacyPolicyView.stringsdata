{
  "source": "/Users/dhavalbhanderi/Desktop/Dhruv/claude-code-starter/apps/Roadivo/Features/Shared/PrivacyPolicyView.swift",
  "tables": {
    "Localizable": [
      {
        "comment": "",
        "key": "Privacy Policy",
        "location": {
          "startingColumn": 26,
          "startingLine": 39
        }
      },
      {
        "comment": "",
        "key": "Roadivo is a media player. You bring your own playlists, media servers and videos.",
        "location": {
          "startingColumn": 22,
          "startingLine": 17
        }
      },
      {
        "comment": "",
        "key": "Roadivo plays them. This policy explains what happens to your data.",
        "location": {
          "startingColumn": 22,
          "startingLine": 18
        }
      },
      {
        "comment": "",
        "key": "Roadivo Privacy Policy",
        "location": {
          "startingColumn": 26,
          "startingLine": 10
        }
      },
      {
        "comment": "",
        "key": "Last updated: 13 October 2026",
        "location": {
          "startingColumn": 26,
          "startingLine": 13
        }
      },
      {
        "comment": "",
        "key": "•",
        "location": {
          "startingColumn": 38,
          "startingLine": 26
        }
      },
      {
        "comment": "",
        "key": "The short version",
        "location": {
          "startingColumn": 38,
          "startingLine": 52
        }
      },
      {
        "comment": "",
        "key": "Your playlists, media servers, sign-in details and videos stay on your iPhone. We don't record what you watch.",
        "location": {
          "startingColumn": 13,
          "startingLine": 53
        }
      },
      {
        "comment": "",
        "key": "Roadivo has no analytics, no ads and no tracking. It never asks to track you.",
        "location": {
          "startingColumn": 13,
          "startingLine": 54
        }
      },
      {
        "comment": "",
        "key": "There are no accounts, and we never sell or share personal information.",
        "location": {
          "startingColumn": 13,
          "startingLine": 55
        }
      },
      {
        "comment": "",
        "key": "Data stored on your iPhone",
        "location": {
          "startingColumn": 38,
          "startingLine": 57
        }
      },
      {
        "comment": "",
        "key": "Playlist links, Xtream logins and media-server access tokens are kept in the iOS Keychain.",
        "location": {
          "startingColumn": 13,
          "startingLine": 58
        }
      },
      {
        "comment": "",
        "key": "Channel lists, favourites and watch history are kept in the app's private storage.",
        "location": {
          "startingColumn": 13,
          "startingLine": 59
        }
      },
      {
        "comment": "",
        "key": "Videos you import from Photos or Files are copied into the app and deleted when you remove them.",
        "location": {
          "startingColumn": 13,
          "startingLine": 60
        }
      },
      {
        "comment": "",
        "key": "Network connections",
        "location": {
          "startingColumn": 38,
          "startingLine": 62
        }
      },
      {
        "comment": "",
        "key": "Roadivo connects only to the playlist links, IPTV providers and media servers you add, and to the stream addresses they list. Those services have their own privacy policies.",
        "location": {
          "startingColumn": 13,
          "startingLine": 63
        }
      },
      {
        "comment": "",
        "key": "AirPlay sends video only to the screen you pick.",
        "location": {
          "startingColumn": 13,
          "startingLine": 64
        }
      },
      {
        "comment": "",
        "key": "Camera and Photos",
        "location": {
          "startingColumn": 38,
          "startingLine": 66
        }
      },
      {
        "comment": "",
        "key": "The camera is used only while you scan a QR code, and nothing is recorded.",
        "location": {
          "startingColumn": 13,
          "startingLine": 67
        }
      },
      {
        "comment": "",
        "key": "Roadivo sees only the photos and videos you pick.",
        "location": {
          "startingColumn": 13,
          "startingLine": 68
        }
      },
      {
        "comment": "",
        "key": "Purchases",
        "location": {
          "startingColumn": 38,
          "startingLine": 70
        }
      },
      {
        "comment": "",
        "key": "Roadivo Pro is sold through the App Store. Apple handles payment; we never see your card or Apple Account details.",
        "location": {
          "startingColumn": 13,
          "startingLine": 71
        }
      },
      {
        "comment": "",
        "key": "Deleting your data",
        "location": {
          "startingColumn": 38,
          "startingLine": 73
        }
      },
      {
        "comment": "",
        "key": "Delete a source in Settings › Manage Sources, or delete the app to remove everything it stored.",
        "location": {
          "startingColumn": 13,
          "startingLine": 74
        }
      },
      {
        "comment": "",
        "key": "Contact",
        "location": {
          "startingColumn": 38,
          "startingLine": 76
        }
      },
      {
        "comment": "",
        "key": "Questions about this policy? Reach us through Roadivo's App Store page.",
        "location": {
          "startingColumn": 13,
          "startingLine": 77
        }
      }
    ]
  },
  "version": 1
}
