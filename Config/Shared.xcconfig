// Roadivo settings shared by Debug and Release. Committed, so nothing secret: secrets go in
// a gitignored Secrets.xcconfig or the Keychain.

// The Apple Developer Team ID (developer.apple.com → Membership): D.I. Solutions.
DEVELOPMENT_TEAM = JX6Q67DW6M

// "https:$()/$()/" keeps xcconfig from reading the URL's "//" as a comment.
WEB_SCHEME = https:$()/$()/

// Roadivo has no backend in v1 (DECISIONS 6). APIClient reads this so a future
// service (sync, remote config) plugs in without a code change.
API_SCHEME = $(WEB_SCHEME)
API_HOST = api.example.com
API_BASE_URL = $(API_SCHEME)$(API_HOST)

// Terms link shown in Settings and the paywall: Apple's standard EULA. The privacy policy
// is the bundled Docs/Website/roadivo.html (DECISIONS 81), so it needs no URL here.
TERMS_URL = $(WEB_SCHEME)www.apple.com/legal/internet-services/itunes/dev/stdeula/

// The App Store listing's Apple ID (App Store Connect → App Information), for Rate and Share (DECISIONS 64).
APP_STORE_ID = 6824396756

// CarPlay Audio was granted by Apple on 2026-10-20 (DECISIONS 25, 127). Signing needs CarPlay Audio App enabled on
// the App ID; NO again hides every CarPlay promise and drops the entitlement from device builds.
ROADIVO_CARPLAY = YES
ROADIVO_CARPLAY_ENTITLEMENTS_YES = $(ROADIVO_CARPLAY_FILE_$(ROADIVO_CARPLAY_NAVIGATION))
ROADIVO_CARPLAY_ENTITLEMENTS_NO =
// The simulator doesn't check Apple's approval, so its builds carry the entitlement either way and the CarPlay
// window shows Roadivo's CarPlay app.
ROADIVO_CARPLAY_ENTITLEMENTS_NO[sdk=iphonesimulator*] = $(ROADIVO_CARPLAY_FILE_$(ROADIVO_CARPLAY_NAVIGATION))

// CarPlay Navigation, requested from Apple (DECISIONS 147). YES signs with RoadivoNavigation.entitlements and makes
// the car's screen Roadivo's map with turn-by-turn guidance, in place of the media lists (one CarPlay type per app).
// Device builds stay NO until Apple grants it, or signing fails; the simulator shows it for Apple's screenshots.
ROADIVO_CARPLAY_NAVIGATION = NO
ROADIVO_CARPLAY_NAVIGATION[sdk=iphonesimulator*] = YES
ROADIVO_CARPLAY_FILE_NO = Resources/Roadivo.entitlements
ROADIVO_CARPLAY_FILE_YES = Resources/RoadivoNavigation.entitlements
// The car's scene delegate, named in Info.plist: iOS reads the manifest for CarPlay rather than asking AppDelegate.
ROADIVO_CARPLAY_SCENE_DELEGATE = $(ROADIVO_CARPLAY_DELEGATE_$(ROADIVO_CARPLAY_NAVIGATION))
ROADIVO_CARPLAY_DELEGATE_NO = CarPlaySceneDelegate
ROADIVO_CARPLAY_DELEGATE_YES = CarPlayNavigationSceneDelegate

PRODUCT_NAME = Roadivo
