// Roadivo — settings shared by every build configuration.
// Included by Debug.xcconfig and Release.xcconfig. Committed: nothing secret
// belongs here. Secrets go in a gitignored Secrets.xcconfig or the Keychain.

// The Apple Developer Team ID (developer.apple.com → Membership). Empty until
// the owner picks a team; simulator builds don't need one.
DEVELOPMENT_TEAM =

// "https:$()/$()/" keeps xcconfig from reading the URL's "//" as a comment.
WEB_SCHEME = https:$()/$()/

// Roadivo has no backend in v1 (DECISIONS 6). APIClient reads this so a future
// service (sync, remote config) plugs in without a code change.
API_SCHEME = $(WEB_SCHEME)
API_HOST = api.example.com
API_BASE_URL = $(API_SCHEME)$(API_HOST)

// Legal links shown in Settings. Terms are Apple's standard EULA. The privacy
// URL is a placeholder until the policy is published (DECISIONS 14).
TERMS_URL = $(WEB_SCHEME)www.apple.com/legal/internet-services/itunes/dev/stdeula/
PRIVACY_URL = $(WEB_SCHEME)example.com/roadivo/privacy

// The numeric Apple ID of the App Store listing (App Store Connect → App
// Information → Apple ID), for Settings › Share Roadivo and Rate Roadivo.
// Empty until the App Store Connect record exists (DECISIONS 64): sharing then
// sends the message without a link, and rating shows the system review prompt.
APP_STORE_ID =

// CarPlay (DECISIONS 25). Apple grants the CarPlay audio and video
// entitlements on request (developer.apple.com/contact/carplay). Until they
// are on the App ID, signing with them fails, so they stay off: set YES once
// granted. The CarPlay scene code ships either way and is inert without them.
ROADIVO_CARPLAY = NO
ROADIVO_CARPLAY_ENTITLEMENTS_YES = Resources/Roadivo.entitlements
ROADIVO_CARPLAY_ENTITLEMENTS_NO =

PRODUCT_NAME = Roadivo
