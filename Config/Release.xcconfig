// PlayCarTV — Release build settings. Committed; nothing secret here.

#include "Shared.xcconfig"

SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES
PLAYCARTV_CAR_BROWSER = NO

// Debug mode in every build (owner, 2026-10-27; DECISIONS 170): TestFlight builds carry the touch car screen, the car
// browser and everything else behind `#if DEBUG`, through CarPlay's undocumented window (Audio + Video signing).
// Apple is likely to reject that: delete from here to the end of the file before archiving for the App Store.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
PLAYCARTV_CAR_BROWSER = YES
PLAYCARTV_CARPLAY_APP = screen
PLAYCARTV_CARPLAY_APP[sdk=iphonesimulator*] = window
