<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>APP_STORE_ID</key>
	<string>$(APP_STORE_ID)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PlayCarTV</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>PlayCarTV uses the camera only to scan a QR code that contains a playlist link.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PlayCarTV connects to playlists and video servers on your local network, and shows your iPhone on your car's screen when you broadcast.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>PlayCarTV uses your location to show routes from where you are in Maps, and on CarPlay to tell when the car is parked, so video plays only then. PlayCarTV doesn't store it; routes come from Apple Maps.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PlayCarTV uses the microphone only while you search by voice.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PlayCarTV turns what you say into search text, on your iPhone when your language allows it.</string>
	<key>PLAYCARTV_CARPLAY</key>
	<string>$(PLAYCARTV_CARPLAY)</string>
	<key>PLAYCARTV_CARPLAY_APP</key>
	<string>$(PLAYCARTV_CARPLAY_APP)</string>
	<key>PLAYCARTV_CARPLAY_VIDEO</key>
	<string>$(PLAYCARTV_CARPLAY_VIDEO)</string>
	<key>PLAYCARTV_CAR_BROWSER</key>
	<string>$(PLAYCARTV_CAR_BROWSER)</string>
	<key>PLAYCARTV_DIRECTIONS</key>
	<string>$(PLAYCARTV_DIRECTIONS)</string>
	<key>TERMS_URL</key>
	<string>$(TERMS_URL)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Overpass-Bold.ttf</string>
		<string>Overpass-ExtraBold.ttf</string>
		<string>Overpass-Black.ttf</string>
		<string>OverpassMono-SemiBold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).$(PLAYCARTV_CARPLAY_SCENE_DELEGATE)</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
</dict>
</plist>
