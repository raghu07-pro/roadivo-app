    "This iPhone no longer has the link or login for this source. Delete it and add it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses iPhone hat den Link oder die Anmeldedaten für diese Quelle nicht mehr. Lösche sie und füge sie erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone ya no tiene el enlace ni los datos de acceso de esta fuente. Elimínala y vuelve a añadirla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet iPhone n’a plus le lien ou les identifiants de cette source. Supprimez-la et ajoutez-la à nouveau."
          }
