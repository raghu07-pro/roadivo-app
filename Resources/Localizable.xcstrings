    "What do I need to watch in the car?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was brauche ich, um im Auto zu schauen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué necesito para ver contenido en el coche?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De quoi ai-je besoin pour regarder en voiture ?"
          }
        },
        "hi" : {
          "stringUnit" : {
