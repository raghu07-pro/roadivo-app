    "There are no accounts, and we never sell or share personal information." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Accounts, und wir verkaufen oder teilen niemals personenbezogene Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay cuentas, y nunca vendemos ni compartimos información personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a pas de compte, et nous ne vendons ni ne partageons jamais d’informations personnelles."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई अकाउंट नहीं है, और हम निजी जानकारी कभी न बेचते हैं, न साझा करते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ci sono account e non vendiamo né condividiamo mai dati personali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントはなく、個人情報を販売または共有することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정이 없으며, 개인정보를 판매하거나 공유하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há contas, e nunca vendemos nem compartilhamos informações pessoais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们没有账户系统，也从不出售或分享个人信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們沒有帳號系統，也絕不出售或分享個人資訊。"
          }
        }
      }
    },
