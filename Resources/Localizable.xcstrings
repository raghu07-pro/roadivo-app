    "Plug your iPhone into the car's USB port. For wireless CarPlay, open Settings › General › CarPlay on your iPhone and choose your car." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe dein iPhone am USB-Anschluss des Autos an. Für kabelloses CarPlay öffne auf dem iPhone „Einstellungen“ › „Allgemein“ › „CarPlay“ und wähle dein Auto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el iPhone al puerto USB del coche. Para CarPlay inalámbrico, abre Ajustes › General › CarPlay en el iPhone y elige tu coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branchez votre iPhone sur le port USB de la voiture. Pour CarPlay sans fil, ouvrez Réglages › Général › CarPlay sur l’iPhone et choisissez votre voiture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने iPhone को कार के USB पोर्ट से जोड़ें। वायरलेस CarPlay के लिए iPhone पर सेटिंग्ज़ › सामान्य › CarPlay खोलें और अपनी कार चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega l’iPhone alla porta USB dell’auto. Per CarPlay wireless, apri Impostazioni › Generali › CarPlay sull’iPhone e scegli la tua auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneを車のUSBポートに接続します。ワイヤレスCarPlayの場合は、iPhoneで「設定」›「一般」›「CarPlay」を開いて車を選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 차량의 USB 포트에 연결하십시오. 무선 CarPlay의 경우 iPhone에서 설정 › 일반 › CarPlay를 열고 차량을 선택하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o iPhone à porta USB do carro. Para CarPlay sem fio, abra Ajustes › Geral › CarPlay no iPhone e escolha o seu carro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 iPhone 连接到汽车的 USB 端口。如需无线 CarPlay，请在 iPhone 上打开“设置”›“通用”›“CarPlay”，然后选择你的汽车。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 iPhone 連接到汽車的 USB 埠。若要使用無線 CarPlay，請在 iPhone 上打開「設定」›「一般」›「CarPlay」，然後選擇你的汽車。"
          }
        }
      }
    },
    "Point at a QR code, or pick a photo from the top right." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Kamera auf einen QR-Code oder wähle oben rechts ein Foto aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta a un código QR o elige una foto arriba a la derecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visez un code QR ou choisissez une photo en haut à droite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR कोड की ओर कैमरा करें, या ऊपर दाईं ओर से फ़ोटो चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra un codice QR oppure scegli una foto in alto a destra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR コードにカメラを向けるか、右上から写真を選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "QR 코드에 카메라를 향하거나, 오른쪽 상단에서 사진을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aponte para um código QR ou escolha uma foto no canto superior direito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准QR 码，或从右上角选择照片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對準 QR 碼，或從右上角選擇照片。"
          }
