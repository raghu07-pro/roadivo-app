    },
    "This Plex account has no media server. Roadivo plays your own Plex Media Server (on a computer or NAS) or one shared with you, not Plex's free Movies & TV." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Plex-Konto hat keinen Medienserver. Roadivo spielt deinen eigenen Plex Media Server (auf einem Computer oder NAS) oder einen mit dir geteilten ab, nicht die kostenlosen Filme & Serien von Plex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta de Plex no tiene servidor multimedia. Roadivo reproduce tu propio Plex Media Server (en un ordenador o NAS) o uno compartido contigo, no las películas y series gratuitas de Plex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce compte Plex n’a aucun serveur multimédia. Roadivo lit votre propre Plex Media Server (sur un ordinateur ou un NAS) ou un serveur partagé avec vous, pas les films et séries gratuits de Plex."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस Plex अकाउंट में कोई मीडिया सर्वर नहीं है। Roadivo आपका अपना Plex Media Server (कंप्यूटर या NAS पर) या आपके साथ शेयर किया गया सर्वर चलाता है, Plex की मुफ़्त फ़िल्में और शो नहीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo account Plex non ha un media server. Roadivo riproduce il tuo Plex Media Server (su un computer o NAS) o uno condiviso con te, non i film e le serie gratuiti di Plex."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Plex アカウントにはメディアサーバがありません。Roadivo が再生するのは、ご自身の Plex Media Server（コンピュータや NAS 上）か共有されたサーバで、Plex の無料映画・番組は対象外です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Plex 계정에는 미디어 서버가 없습니다. Roadivo는 직접 운영하는 Plex Media Server(컴퓨터 또는 NAS) 또는 공유받은 서버를 재생하며, Plex의 무료 영화 및 TV는 재생하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conta do Plex não tem servidor de mídia. O Roadivo reproduz o seu próprio Plex Media Server (em um computador ou NAS) ou um compartilhado com você, não os filmes e séries gratuitos do Plex."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Plex 账户没有媒体服务器。Roadivo 播放的是你自己的 Plex Media Server（在电脑或 NAS 上）或别人与你共享的服务器，而不是 Plex 的免费影视内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Plex 帳號沒有媒體伺服器。Roadivo 播放的是你自己的 Plex Media Server（在電腦或 NAS 上）或別人與你共享的伺服器，而不是 Plex 的免費影視內容。"
          }
        }
      }
    },
    "This source's link isn't on this iPhone. Add the source again to copy it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Link dieser Quelle ist nicht auf diesem iPhone. Füge die Quelle erneut hinzu, um ihn zu kopieren."
