    "Each group shows its first 20 channels in a row. Tap See All for the rest, or use search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Gruppe zeigt ihre ersten 20 Sender in einer Reihe. Tippe auf „Alle anzeigen“ für den Rest oder nutze die Suche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo muestra sus primeros 20 canales en una fila. Toca Ver todo para ver el resto o usa la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque groupe affiche ses 20 premières chaînes sur une rangée. Touchez Tout afficher pour voir le reste, ou utilisez la recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ग्रुप एक पंक्ति में अपने पहले 20 चैनल दिखाता है। बाकी के लिए सभी देखें पर टैप करें, या सर्च करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni gruppo mostra i primi 20 canali in una riga. Tocca “Mostra tutto” per gli altri, oppure usa la ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各グループの最初の20チャンネルが1列に表示されます。残りは「すべて表示」をタップするか、検索を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 그룹의 처음 20개 채널이 한 줄에 표시됩니다. 나머지는 모두 보기를 탭하거나 검색을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo mostra seus primeiros 20 canais em uma fileira. Toque em Ver Tudo para ver o restante ou use a busca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个分组在一行中显示前 20 个频道。轻点“查看全部”查看其余频道，或使用搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個群組在一列中顯示前 20 個頻道。點一下「顯示全部」查看其餘頻道，或使用搜尋。"
          }
        }
      }
    },
    "Enter the server, username and password your IPTV provider gave you." : {
