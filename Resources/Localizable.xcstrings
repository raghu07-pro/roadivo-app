      }
    },
    "Everything you add stays on this iPhone. Links and logins are kept in the Keychain. Roadivo has no account, no ads and no tracking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was du hinzufügst, bleibt auf diesem iPhone. Links und Anmeldedaten werden im Schlüsselbund gesichert. Roadivo hat keinen Account, keine Werbung und kein Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que añades se queda en este iPhone. Los enlaces y los datos de inicio de sesión se guardan en el Llavero. Roadivo no tiene cuentas, anuncios ni rastreo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que vous ajoutez reste sur cet iPhone. Les liens et identifiants sont conservés dans le trousseau. Roadivo n’a ni compte, ni publicité, ni suivi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो भी जोड़ते हैं, वह इसी iPhone पर रहता है। लिंक और लॉगिन कीचेन में रखे जाते हैं। Roadivo में न कोई अकाउंट है, न विज्ञापन, न ट्रैकिंग।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che aggiungi resta su questo iPhone. Link e credenziali sono conservati nel Portachiavi. Roadivo non ha account, pubblicità né tracciamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加したものはすべてこの iPhone に保存されます。リンクとログイン情報はキーチェーンに保管されます。Roadivo にはアカウント、広告、トラッキングはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가한 모든 항목은 이 iPhone에 보관됩니다. 링크와 로그인 정보는 키체인에 저장됩니다. Roadivo에는 계정, 광고, 추적이 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que você adiciona fica neste iPhone. Links e logins ficam guardados nas Chaves. O Roadivo não tem conta, anúncios nem rastreamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你添加的所有内容都保留在此 iPhone 上。链接和登录信息保存在钥匙串中。Roadivo 没有账户、没有广告，也不跟踪你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你加入的所有內容都保留在此 iPhone 上。連結和登入資訊儲存在鑰匙圈中。Roadivo 沒有帳號、沒有廣告，也不追蹤你。"
          }
        }
      }
    },
