    "Connect your iPhone to the car's AirPlay display or wireless adapter, usually through its Wi‑Fi." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dein iPhone mit dem AirPlay-Display oder Funkadapter des Autos, meist über dessen WLAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta tu iPhone a la pantalla AirPlay o al adaptador inalámbrico del coche, normalmente a través de su Wi‑Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez votre iPhone à l’écran AirPlay ou à l’adaptateur sans fil de la voiture, généralement via son Wi‑Fi."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने iPhone को कार के AirPlay डिस्प्ले या वायरलेस अडैप्टर से कनेक्ट करें, आमतौर पर उसके Wi‑Fi के ज़रिए।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega l’iPhone allo schermo AirPlay o all’adattatore wireless dell’auto, di solito tramite la sua rete Wi‑Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneを車のAirPlayディスプレイまたはワイヤレスアダプタに接続します（通常はそのWi‑Fi経由）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone을 차량의 AirPlay 디스플레이 또는 무선 어댑터에 연결하세요. 보통 해당 Wi‑Fi를 통해 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o iPhone à tela AirPlay ou ao adaptador sem fio do carro, geralmente pelo Wi‑Fi dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 iPhone 连接到车辆的 AirPlay 显示屏或无线适配器，通常通过其 Wi‑Fi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將 iPhone 連接到車輛的 AirPlay 顯示器或無線轉接器，通常透過其 Wi‑Fi。"
          }
        }
      }
    },
