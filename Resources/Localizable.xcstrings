    "Its channels, favorites and watch history are removed from Roadivo. To add it again, you'll need its link or login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sender, Favoriten und der Wiedergabeverlauf dieser Quelle werden aus Roadivo entfernt. Um sie wieder hinzuzufügen, brauchst du ihren Link oder deine Anmeldedaten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus canales, favoritos e historial de reproducción se eliminan de Roadivo. Para volver a añadirla, necesitarás su enlace o tus datos de acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses chaînes, favoris et historique de lecture sont supprimés de Roadivo. Pour l’ajouter à nouveau, il vous faudra son lien ou vos identifiants."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसके चैनल, पसंदीदा और देखने का इतिहास Roadivo से हटा दिए जाएँगे। इसे फिर से जोड़ने के लिए आपको इसका लिंक या लॉगिन चाहिए होगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I suoi canali, i preferiti e la cronologia di visione vengono rimossi da Roadivo. Per aggiungerla di nuovo ti serviranno il link o i dati di accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このソースのチャンネル、お気に入り、再生履歴が Roadivo から削除されます。もう一度追加するには、リンクまたはログイン情報が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 소스의 채널, 즐겨찾기, 시청 기록이 Roadivo에서 삭제됩니다. 다시 추가하려면 링크나 로그인 정보가 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os canais, favoritos e o histórico de reprodução dela são removidos do Roadivo. Para adicioná-la de novo, você vai precisar do link ou do login."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其频道、收藏和观看记录将从 Roadivo 中移除。如需重新添加，你需要它的链接或登录信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其頻道、收藏和觀看記錄會從 Roadivo 移除。如需重新加入，你需要它的連結或登入資料。"
          }
        }
      }
    },
    "Join a Wi‑Fi network or turn on Personal Hotspot first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde dich zuerst mit einem WLAN oder aktiviere den persönlichen Hotspot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero conéctate a una red Wi‑Fi o activa el punto de acceso personal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous d’abord à un réseau Wi‑Fi ou activez le partage de connexion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पहले किसी Wi‑Fi नेटवर्क से जुड़ें या पर्सनल हॉटस्पॉट चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima connettiti a una rete Wi‑Fi o attiva l’hotspot personale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず Wi‑Fi ネットワークに接続するか、インターネット共有をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 Wi‑Fi 네트워크에 연결하거나 개인용 핫스팟을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro, conecte-se a uma rede Wi‑Fi ou ative o Acesso Pessoal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先连接 Wi‑Fi 网络或打开个人热点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先連接 Wi‑Fi 網路或開啟個人熱點。"
          }
        }
      }
    },
    "Join the car's screen to the same Wi‑Fi as this iPhone, or to this iPhone's Personal Hotspot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde das Autodisplay mit demselben WLAN wie dieses iPhone oder mit dem persönlichen Hotspot dieses iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta la pantalla del coche a la misma red Wi‑Fi que este iPhone o al punto de acceso personal de este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez l’écran de la voiture au même Wi‑Fi que cet iPhone, ou au partage de connexion de cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार की स्क्रीन को इस iPhone वाले Wi‑Fi से, या इस iPhone के पर्सनल हॉटस्पॉट से जोड़ें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega lo schermo dell’auto alla stessa rete Wi‑Fi di questo iPhone o all’hotspot personale di questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車の画面を、この iPhone と同じ Wi‑Fi か、この iPhone のインターネット共有に接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차량 화면을 이 iPhone과 같은 Wi‑Fi나 이 iPhone의 개인용 핫스팟에 연결하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte a tela do carro ao mesmo Wi‑Fi deste iPhone ou ao Acesso Pessoal deste iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将车机屏幕连接到与此 iPhone 相同的 Wi‑Fi，或连接到此 iPhone 的个人热点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將車機螢幕連接到與此 iPhone 相同的 Wi‑Fi，或連接到此 iPhone 的個人熱點。"
          }
        }
      }
    },
