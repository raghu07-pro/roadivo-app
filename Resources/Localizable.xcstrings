    "Each group shows its first 20 channels in a row. Tap the group's name for all of them, or use search." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Gruppe zeigt ihre ersten 20 Sender in einer Reihe. Tippe auf den Namen der Gruppe, um alle zu sehen, oder nutze die Suche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo muestra sus primeros 20 canales en una fila. Toca el nombre del grupo para verlos todos o usa la búsqueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque groupe affiche ses 20 premières chaînes sur une rangée. Touchez le nom du groupe pour toutes les voir, ou utilisez la recherche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर ग्रुप एक पंक्ति में अपने पहले 20 चैनल दिखाता है। सभी देखने के लिए ग्रुप के नाम पर टैप करें, या सर्च करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni gruppo mostra i primi 20 canali in una riga. Tocca il nome del gruppo per vederli tutti, oppure usa la ricerca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各グループの最初の20チャンネルが1列に表示されます。すべて見るにはグループ名をタップするか、検索を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 그룹의 처음 20개 채널이 한 줄에 표시됩니다. 모두 보려면 그룹 이름을 탭하거나 검색을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grupo mostra seus primeiros 20 canais em uma fileira. Toque no nome do grupo para ver todos ou use a busca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个分组在一行中显示前 20 个频道。轻点分组名称查看全部频道，或使用搜索。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個群組在一列中顯示前 20 個頻道。點一下群組名稱查看全部頻道，或使用搜尋。"
          }
        }
      }
    },
