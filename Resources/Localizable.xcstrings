          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay वाले कार डिस्प्ले, वायरलेस अडैप्टर या TV पर वीडियो भेजें।"
          }
        },
        "it" : {
