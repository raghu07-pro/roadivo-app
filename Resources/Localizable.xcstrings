    "Automatic follows Subtitles & Captioning in your iPhone's Accessibility settings. On shows this language when the video has it, otherwise its first subtitles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch“ folgt „Untertitel & erweiterte Untertitel“ in den Bedienungshilfen deines iPhone. „Ein“ zeigt diese Sprache, wenn das Video sie hat, sonst seine ersten Untertitel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue Subtítulos y subtitulación en los ajustes de Accesibilidad del iPhone. Activado muestra este idioma si el vídeo lo tiene; si no, sus primeros subtítulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit Sous-titres et sous-titrage dans les réglages d'Accessibilité de l'iPhone. Activé affiche cette langue si la vidéo l'a, sinon ses premiers sous-titres."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्वचालित आपके iPhone की ऐक्सेसिबिलिटी सेटिंग्ज़ में सबटाइटल और कैप्शनिंग का पालन करता है। चालू होने पर, वीडियो में यह भाषा हो तो वही दिखती है, नहीं तो उसके पहले सबटाइटल।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico segue Sottotitoli e didascalie nelle impostazioni di Accessibilità dell'iPhone. Attivo mostra questa lingua se il video la include, altrimenti i suoi primi sottotitoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」はiPhoneのアクセシビリティ設定の「字幕とキャプション」に従います。「オン」はビデオにこの言語があればそれを、なければ最初の字幕を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'자동'은 iPhone 손쉬운 사용 설정의 '자막 및 캡션'을 따릅니다. '켬'은 비디오에 이 언어가 있으면 표시하고, 없으면 첫 번째 자막을 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático segue Legendas e Legendas Ocultas nos ajustes de Acessibilidade do iPhone. Ativado mostra este idioma quando o vídeo o tem; senão, as primeiras legendas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”遵循 iPhone 辅助功能设置中的“字幕与说明文字”。“开启”时，如果视频有此语言就显示它，否则显示第一个字幕。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」會依照 iPhone 輔助使用設定中的「字幕與隱藏式字幕」。「開啟」會在影片有此語言時顯示，否則顯示第一個字幕。"
          }
        }
      }
    },
