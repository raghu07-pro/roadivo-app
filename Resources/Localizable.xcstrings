    "Turn on Local Network for Roadivo in Settings, or the car's screen can't reach this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere in den Einstellungen „Lokales Netzwerk“ für Roadivo, sonst kann das Autodisplay dieses iPhone nicht erreichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Red local para Roadivo en Ajustes; si no, la pantalla del coche no podrá conectarse a este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Réseau local pour Roadivo dans Réglages, sinon l’écran de la voiture ne pourra pas joindre cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सेटिंग्स में Roadivo के लिए लोकल नेटवर्क चालू करें, वरना कार की स्क्रीन इस iPhone तक नहीं पहुँच पाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Rete locale per Roadivo in Impostazioni, altrimenti lo schermo dell’auto non può raggiungere questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で Roadivo のローカルネットワークをオンにしてください。オフのままだと、車の画面からこの iPhone に接続できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 Roadivo의 로컬 네트워크를 켜세요. 그렇지 않으면 차량 화면이 이 iPhone에 연결할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a Rede Local para o Roadivo em Ajustes, ou a tela do carro não conseguirá acessar este iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“设置”中为 Roadivo 打开“本地网络”，否则车机屏幕无法连接此 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「設定」中為 Roadivo 開啟「區域網路」，否則車機螢幕無法連線到此 iPhone。"
          }
        }
      }
    },
    "Turn on Location in Settings to see routes from where you are." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die Ortungsdienste in den Einstellungen, um Routen von deinem Standort aus zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la ubicación en Ajustes para ver rutas desde donde estás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez la localisation dans Réglages pour voir les itinéraires depuis l’endroit où vous êtes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपनी जगह से रास्ते देखने के लिए सेटिंग्स में लोकेशन चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la posizione in Impostazioni per vedere i percorsi da dove ti trovi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定で位置情報をオンにすると、現在地からの経路を表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 위치를 켜면 현재 위치에서 가는 경로를 볼 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a localização em Ajustes para ver rotas a partir de onde você está."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中打开定位，即可查看从你所在位置出发的路线。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中開啟定位，即可查看從你所在位置出發的路線。"
          }
        }
      }
    },
    "Turn on Microphone and Speech Recognition for Roadivo in Settings to search by voice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere in den Einstellungen Mikrofon und Spracherkennung für Roadivo, um per Sprache zu suchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el micrófono y el reconocimiento de voz para Roadivo en Ajustes para buscar por voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le micro et la reconnaissance vocale pour Roadivo dans Réglages pour rechercher par la voix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बोलकर खोजने के लिए सेटिंग्स में Roadivo के लिए माइक्रोफ़ोन और स्पीच रिकग्निशन चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Microfono e Riconoscimento vocale per Roadivo in Impostazioni per cercare con la voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声で検索するには、設定で Roadivo のマイクと音声認識をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음성으로 검색하려면 설정에서 Roadivo의 마이크와 음성 인식을 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Microfone e o Reconhecimento de Fala para o Roadivo em Ajustes para buscar por voz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要使用语音搜索，请在“设置”中为 Roadivo 打开麦克风和语音识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要使用語音搜尋，請在「設定」中為 Roadivo 開啟麥克風和語音辨識。"
          }
        }
      }
    },
