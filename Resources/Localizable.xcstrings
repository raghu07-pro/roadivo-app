    "Your login is kept in this iPhone's Keychain and sent only to that server." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldedaten werden im Schlüsselbund dieses iPhone gesichert und nur an diesen Server gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos de inicio de sesión se guardan en el Llavero de este iPhone y solo se envían a ese servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos identifiants sont conservés dans le trousseau de cet iPhone et envoyés uniquement à ce serveur."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका लॉगिन इस iPhone के कीचेन में रखा जाता है और सिर्फ़ उसी सर्वर को भेजा जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue credenziali sono conservate nel Portachiavi di questo iPhone e inviate solo a quel server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン情報はこの iPhone のキーチェーンに保管され、そのサーバにのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 정보는 이 iPhone의 키체인에 보관되며 해당 서버로만 전송됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu login fica guardado nas Chaves deste iPhone e é enviado apenas para esse servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的登录信息保存在此 iPhone 的钥匙串中，并且只会发送到该服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的登入資訊儲存在此 iPhone 的鑰匙圈中，並且只會傳送到該伺服器。"
          }
        }
      }
    },
    "Your password is used once to sign in. Roadivo keeps only the server's access token, in the Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort wird einmalig zur Anmeldung verwendet. Roadivo behält nur das Zugriffstoken des Servers, im Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña se usa una sola vez para iniciar sesión. Roadivo solo guarda el token de acceso del servidor, en el Llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe n’est utilisé qu’une fois pour la connexion. Roadivo conserve uniquement le jeton d’accès du serveur, dans le trousseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका पासवर्ड सिर्फ़ एक बार साइन इन करने के लिए इस्तेमाल होता है। Roadivo कीचेन में सिर्फ़ सर्वर का एक्सेस टोकन रखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La password viene usata una sola volta per accedere. Roadivo conserva solo il token di accesso del server, nel Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パスワードはサインイン時に一度だけ使用されます。Roadivo はサーバのアクセストークンのみをキーチェーンに保管します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암호는 로그인할 때 한 번만 사용됩니다. Roadivo는 서버의 액세스 토큰만 키체인에 보관합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua senha é usada uma única vez para iniciar sessão. O Roadivo guarda apenas o token de acesso do servidor, nas Chaves."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密码仅用于登录一次。Roadivo 只在钥匙串中保存服务器的访问令牌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密碼僅用於登入一次。Roadivo 只會在鑰匙圈中儲存伺服器的存取權杖。"
          }
        }
      }
    },
    "Your playlists, media servers, sign-in details and videos stay on your iPhone. We don't record what you watch." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Playlists, Medienserver, Anmeldedaten und Videos bleiben auf deinem iPhone. Wir zeichnen nicht auf, was du ansiehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus listas, servidores multimedia, datos de inicio de sesión y vídeos se quedan en tu iPhone. No registramos lo que ves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos playlists, serveurs multimédias, identifiants et vidéos restent sur votre iPhone. Nous n’enregistrons pas ce que vous regardez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी प्लेलिस्ट, मीडिया सर्वर, साइन-इन जानकारी और वीडियो आपके iPhone पर ही रहते हैं। आप क्या देखते हैं, हम रिकॉर्ड नहीं करते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlist, media server, dati di accesso e video restano sul tuo iPhone. Non registriamo cosa guardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリスト、メディアサーバ、サインイン情報、ビデオは iPhone に保存されます。視聴内容は記録しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록, 미디어 서버, 로그인 정보 및 비디오는 iPhone에 보관됩니다. 시청 내용은 기록하지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas playlists, servidores de mídia, dados de login e vídeos ficam no seu iPhone. Não registramos o que você assiste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的播放列表、媒体服务器、登录信息和视频都保留在你的 iPhone 上。我们不会记录你观看的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的播放列表、媒體伺服器、登入資訊和影片都保留在你的 iPhone 上。我們不會記錄你觀看的內容。"
          }
        }
      }
    },
    "Your purchase is waiting for approval. Pro unlocks as soon as it's approved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Genehmigung. Pro wird freigeschaltet, sobald er genehmigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está pendiente de aprobación. Pro se desbloqueará en cuanto se apruebe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat est en attente d’approbation. Pro sera débloqué dès son approbation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी खरीदारी मंज़ूरी का इंतज़ार कर रही है। मंज़ूरी मिलते ही Pro अनलॉक हो जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo acquisto è in attesa di approvazione. Pro si sbloccherà non appena verrà approvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は承認待ちです。承認されるとすぐに Pro が利用可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구입이 승인 대기 중입니다. 승인되는 즉시 Pro가 잠금 해제됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua compra está aguardando aprovação. O Pro será desbloqueado assim que for aprovada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的购买正在等待批准。获批后 Pro 将立即解锁。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的購買項目正在等待核准。核准後 Pro 會立即解鎖。"
          }
        }
      }
    },
