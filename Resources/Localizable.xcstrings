        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo はそれらを再生します。このポリシーでは、お客様のデータの取り扱いについて説明します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo는 이를 재생합니다. 이 방침은 사용자의 데이터가 어떻게 처리되는지 설명합니다."
          }
        },
        "pt-BR" : {
