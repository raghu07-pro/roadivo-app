    "Open Roadivo on the car's screen and pick from Favorites, Recent or Library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Roadivo auf dem Bildschirm des Autos und wähle aus Favoriten, Zuletzt oder Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Roadivo en la pantalla del coche y elige en Favoritos, Recientes o Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Roadivo sur l’écran de la voiture et choisissez dans Favoris, Récents ou Bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार की स्क्रीन पर Roadivo खोलें और पसंदीदा, हाल के या लाइब्रेरी में से चुनें।"
