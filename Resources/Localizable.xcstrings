    "Connect CarPlay, then open Roadivo on the car's screen to pick from Favorites, Recent and Library." : {
      "comment" : "A description of how to connect CarPlay to Roadivo.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde CarPlay und öffne Roadivo auf dem Bildschirm im Auto, um aus Favoriten, Zuletzt und Mediathek zu wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta CarPlay y abre Roadivo en la pantalla del coche para elegir entre Favoritos, Recientes y Biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez CarPlay, puis ouvrez Roadivo sur l’écran de la voiture pour choisir parmi Favoris, Récents et Bibliothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay कनेक्ट करें, फिर कार की स्क्रीन पर Roadivo खोलें और पसंदीदा, हाल के और लाइब्रेरी में से चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connetti CarPlay, poi apri Roadivo sullo schermo dell’auto per scegliere tra Preferiti, Recenti e Libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay に接続し、車の画面で Roadivo を開いて、お気に入り、最近、ライブラリから選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CarPlay를 연결한 다음 차량 화면에서 Roadivo를 열어 즐겨찾기, 최근 항목 및 보관함에서 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o CarPlay e abra o Roadivo na tela do carro para escolher em Favoritos, Recentes e Biblioteca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
