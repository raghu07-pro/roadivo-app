    },
    "That playlist is too large to load on iPhone. Ask your provider for a smaller list, such as live TV only." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Playlist ist zu groß, um sie auf dem iPhone zu laden. Bitte deinen Anbieter um eine kleinere Liste, zum Beispiel nur Live-TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa lista es demasiado grande para cargarla en el iPhone. Pide a tu proveedor una lista más pequeña, por ejemplo solo de TV en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette playlist est trop volumineuse pour être chargée sur iPhone. Demandez à votre fournisseur une liste plus petite, par exemple la TV en direct uniquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्लेलिस्ट iPhone पर लोड करने के लिए बहुत बड़ी है। अपने प्रोवाइडर से छोटी सूची माँगें, जैसे सिर्फ़ लाइव TV।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa playlist è troppo grande per essere caricata su iPhone. Chiedi al tuo provider una lista più piccola, ad esempio solo la TV in diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプレイリストは大きすぎて iPhone で読み込めません。ライブ TV のみなど、より小さいリストをプロバイダに依頼してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 재생목록은 너무 커서 iPhone에서 불러올 수 없습니다. 라이브 TV만 포함된 목록처럼 더 작은 목록을 제공업체에 요청하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essa playlist é grande demais para carregar no iPhone. Peça ao seu provedor uma lista menor, como apenas TV ao vivo."
          }
