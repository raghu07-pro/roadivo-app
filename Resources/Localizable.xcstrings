        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App の使用中に問題が発生した場合はどうすればよいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 사용 중 문제가 발생하면 어떻게 해야 하나요?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que devo fazer se algo der errado ao usar o app?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 App 时出现问题该怎么办？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 App 時發生問題該怎麼辦？"
          }
        }
      }
    },
    "When %@ connects, Home switches to the preferred source, and Car Mode opens if something is playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %@ verbunden wird, zeigt Home die bevorzugte Quelle, und der Automodus öffnet sich, falls etwas läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ se conecte, Inicio mostrará la fuente preferida y se abrirá el Modo Coche si hay algo reproduciéndose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand %@ se connecte, l'Accueil passe à la source préférée et le Mode Voiture s'ouvre si une lecture est en cours."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ जुड़ने पर होम पसंदीदा सोर्स पर चला जाएगा, और अगर कुछ चल रहा हो तो कार मोड खुल जाएगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ si collega, la Home passa alla sorgente preferita e, se è in riproduzione qualcosa, si apre la Modalità Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が接続されると、ホームは優先するソースに切り替わり、再生中ならカーモードが開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 연결되면 홈이 선호 소스로 전환되고, 재생 중인 항목이 있으면 차량 모드가 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ se conectar, o Início muda para a fonte preferida e o Modo Carro abre se algo estiver tocando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 连接后，主页会切换到首选来源；如果正在播放，还会打开车载模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 連接後，首頁會切換到偏好來源；如果正在播放，還會開啟車用模式。"
          }
        }
      }
    },
