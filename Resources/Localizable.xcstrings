    "Add an M3U link or connect a media server, and your channels land here. Videos you import are in Favorites › On this iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen M3U-Link hinzu oder verbinde einen Medienserver, dann erscheinen deine Kanäle hier. Importierte Videos findest du unter Favoriten › Auf diesem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un enlace M3U o conecta un servidor multimedia y tus canales aparecerán aquí. Los vídeos que importes están en Favoritos › En este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un lien M3U ou connectez un serveur multimédia, et vos chaînes apparaîtront ici. Les vidéos importées se trouvent dans Favoris › Sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U लिंक जोड़ें या मीडिया सर्वर कनेक्ट करें, आपके चैनल यहाँ दिखेंगे। इंपोर्ट किए गए वीडियो पसंदीदा › इस iPhone पर में हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un link M3U o collega un media server e i tuoi canali appariranno qui. I video importati sono in Preferiti › Su questo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U リンクを追加するかメディアサーバに接続すると、チャンネルがここに表示されます。読み込んだビデオは「お気に入り › この iPhone 上」にあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U 링크를 추가하거나 미디어 서버에 연결하면 채널이 여기에 표시됩니다. 가져온 동영상은 즐겨찾기 › 이 iPhone에서에 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um link M3U ou conecte um servidor de mídia e seus canais aparecerão aqui. Os vídeos importados ficam em Favoritos › Neste iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 M3U 链接或连接媒体服务器后，你的频道会显示在这里。导入的视频在“收藏 › 在此 iPhone 上”中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 M3U 連結或連線媒體伺服器後，你的頻道會顯示在這裡。匯入的影片在「收藏 › 在此 iPhone 上」中。"
          }
        }
      }
    },
    "Add an M3U link or QR code, or import videos from Photos and Files. Sorted automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen M3U-Link oder QR-Code hinzu oder importiere Videos aus Fotos und Dateien. Wird automatisch sortiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un enlace M3U o un código QR, o importa vídeos desde Fotos y Archivos. Se ordenan automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un lien M3U ou un code QR, ou importez des vidéos depuis Photos et Fichiers. Le tri est automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U लिंक या QR कोड जोड़ें, या फ़ोटो और फ़ाइलें से वीडियो इम्पोर्ट करें। सब अपने आप व्यवस्थित हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un link M3U o un codice QR, oppure importa video da Foto e File. Ordinati automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U リンクや QR コードを追加するか、写真やファイルからビデオを読み込みます。自動で整理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U 링크나 QR 코드를 추가하거나 사진 및 파일에서 비디오를 가져오세요. 자동으로 정리됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um link M3U ou código QR, ou importe vídeos de Fotos e Arquivos. Tudo organizado automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 M3U 链接或 QR 码，或从“照片”和“文件”导入视频。自动分类整理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 M3U 連結或 QR 碼，或從「照片」和「檔案」匯入影片。自動分類整理。"
          }
        }
      }
    },
