    "Roadivo Pro is sold through the App Store. Apple handles payment; we never see your card or Apple Account details." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro wird über den App Store verkauft. Apple wickelt die Zahlung ab; wir sehen niemals deine Karte oder deine Apple Account-Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro se vende a través del App Store. Apple gestiona el pago; nunca vemos los datos de tu tarjeta ni de tu Cuenta de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro est vendu via l’App Store. Apple gère le paiement ; nous ne voyons jamais les informations de votre carte ou de votre Compte Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro, App Store के ज़रिए बेचा जाता है। भुगतान Apple संभालता है; हम आपके कार्ड या Apple खाता की जानकारी कभी नहीं देखते।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro è venduto tramite l’App Store. Il pagamento è gestito da Apple; non vediamo mai la tua carta né i dati del tuo Account Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro は App Store で販売されています。支払いは Apple が処理し、カードや Apple アカウントの情報が当社に共有されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro는 App Store를 통해 판매됩니다. 결제는 Apple이 처리하며, 저희는 사용자의 카드나 Apple 계정 정보를 볼 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Roadivo Pro é vendido pela App Store. A Apple processa o pagamento; nunca vemos os dados do seu cartão ou do seu Conta Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro 通过 App Store 销售。付款由 Apple 处理；我们永远不会看到你的银行卡或 Apple 账户信息。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo Pro 透過 App Store 銷售。付款由 Apple 處理；我們絕不會看到你的信用卡或 Apple 帳號資訊。"
          }
        }
      }
    },
