    "Fit shows the whole picture. Fill crops it to cover the screen. Stretch fills the screen without cropping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einpassen“ zeigt das ganze Bild. „Füllen“ schneidet es zu, damit es den Bildschirm füllt. „Strecken“ füllt den Bildschirm, ohne zuzuschneiden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar muestra la imagen completa. Rellenar la recorta para cubrir la pantalla. Estirar llena la pantalla sin recortar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapter affiche l'image entière. Remplir la recadre pour couvrir l'écran. Étirer remplit l'écran sans recadrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िट पूरी तस्वीर दिखाता है। भरें स्क्रीन ढकने के लिए उसे काटता है। खींचें बिना काटे स्क्रीन भरता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adatta mostra l'immagine intera. Riempi la ritaglia per coprire lo schermo. Allunga riempie lo schermo senza ritagliare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「フィット」は映像全体を表示します。「フィル」は画面を覆うように切り取ります。「ストレッチ」は切り取らずに画面いっぱいに広げます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'맞춤'은 영상 전체를 보여 줍니다. '채우기'는 화면을 채우도록 잘라냅니다. '늘이기'는 자르지 않고 화면을 채웁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar mostra a imagem inteira. Preencher a corta para cobrir a tela. Esticar preenche a tela sem cortar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“适应”显示完整画面。“填充”会裁切画面以铺满屏幕。“拉伸”铺满屏幕但不裁切。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「符合」顯示完整畫面。「填滿」會裁切畫面以布滿螢幕。「延展」布滿螢幕但不裁切。"
          }
        }
      }
    },
