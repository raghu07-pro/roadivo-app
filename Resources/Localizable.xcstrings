    "For passengers, or while parked. Never watch video while driving." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Mitfahrende oder beim Parken. Schau niemals Videos während der Fahrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para los pasajeros o con el coche aparcado. No veas nunca vídeos mientras conduces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les passagers, ou à l’arrêt. Ne regardez jamais de vidéo en conduisant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रियों के लिए, या गाड़ी पार्क होने पर। गाड़ी चलाते समय कभी वीडियो न देखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per i passeggeri o con l’auto parcheggiata. Non guardare mai video mentre guidi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同乗者向け、または駐車中にご利用ください。運転中は絶対にビデオを見ないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동승자용 또는 주차 중에만 사용하세요. 운전 중에는 절대 비디오를 시청하지 마세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para passageiros ou com o carro estacionado. Nunca assista a vídeos enquanto dirige."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供乘客观看，或在停车时观看。切勿在驾驶时观看视频。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供乘客觀看，或在停車時觀看。駕駛時切勿觀看影片。"
          }
        }
      }
    },
