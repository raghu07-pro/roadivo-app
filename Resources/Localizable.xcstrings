    "Hear Roadivo through the car, watch on its screen with AirPlay, or use a mounted iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hör Roadivo über das Auto, schau per AirPlay auf seinem Bildschirm oder nutze ein befestigtes iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha Roadivo a través del coche, míralo en su pantalla con AirPlay o usa un iPhone en un soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez Roadivo dans la voiture, regardez sur son écran avec AirPlay, ou utilisez un iPhone fixé sur un support."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo को कार के ज़रिए सुनें, AirPlay से उसकी स्क्रीन पर देखें, या माउंट किया iPhone इस्तेमाल करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta Roadivo tramite l’auto, guardalo sul suo schermo con AirPlay o usa un iPhone su supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車でRoadivoの音声を聴いたり、AirPlayで車の画面で観たり、固定したiPhoneで使ったりできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차량으로 Roadivo를 듣거나, AirPlay로 차량 화면에서 보거나, 거치한 iPhone을 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouça o Roadivo pelo carro, assista na tela dele com AirPlay ou use um iPhone preso num suporte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过汽车收听 Roadivo，用隔空播放在车载屏幕上观看，或使用固定在支架上的 iPhone。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過汽車收聽 Roadivo，用 AirPlay 在車用螢幕上觀看，或使用固定在支架上的 iPhone。"
          }
        }
      }
    },
