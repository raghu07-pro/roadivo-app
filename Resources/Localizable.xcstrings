    "Roadivo plays them. This policy explains what happens to your data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo spielt sie ab. Diese Erklärung beschreibt, was mit deinen Daten passiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo los reproduce. Esta política explica qué ocurre con tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo les lit. Cette politique explique ce qu’il advient de vos données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo उन्हें चलाता है। यह नीति बताती है कि आपके डेटा के साथ क्या होता है।"
          }
        },
        "it" : {
