    "Check each stream to see which ones answer, which are slow and which have stopped working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe jeden Stream, um zu sehen, welche antworten, welche langsam sind und welche nicht mehr funktionieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba cada transmisión para ver cuáles responden, cuáles van lentas y cuáles han dejado de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez chaque flux pour voir lesquels répondent, lesquels sont lents et lesquels ne fonctionnent plus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर स्ट्रीम जाँचें, ताकि पता चले कौन से जवाब देते हैं, कौन से धीमे हैं और कौन से बंद हो गए हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla ogni stream per vedere quali rispondono, quali sono lenti e quali hanno smesso di funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各ストリームを確認して、応答するもの、遅いもの、動かなくなったものを調べます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 스트림을 확인해 응답하는 스트림, 느린 스트림, 작동하지 않는 스트림을 알아보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique cada stream para ver quais respondem, quais estão lentos e quais pararam de funcionar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
