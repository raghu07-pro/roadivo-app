    "Playlist links, Xtream logins and media-server access tokens are kept in the iOS Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playlist-Links, Xtream-Anmeldedaten und Zugriffstoken für Medienserver werden im iOS-Schlüsselbund gesichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces de listas, los datos de acceso de Xtream y los tokens de acceso de servidores multimedia se guardan en el Llavero de iOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens de playlists, les identifiants Xtream et les jetons d’accès aux serveurs multimédias sont conservés dans le trousseau iOS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्लेलिस्ट लिंक, Xtream लॉगिन और मीडिया सर्वर एक्सेस टोकन iOS कीचेन में रखे जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link delle playlist, credenziali Xtream e token di accesso dei media server sono conservati nel Portachiavi di iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストのリンク、Xtream のログイン情報、メディアサーバのアクセストークンは iOS のキーチェーンに保管されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재생목록 링크, Xtream 로그인 정보 및 미디어 서버 액세스 토큰은 iOS 키체인에 보관됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
