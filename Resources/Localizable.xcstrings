        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo est uniquement un lecteur. Il n’inclut et ne vend aucune chaîne ni aucun contenu."
          }
        },
        "hi" : {
          "stringUnit" : {
