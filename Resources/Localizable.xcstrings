    },
    "What is a source? Does Roadivo come with channels?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist eine Quelle? Enthält Roadivo Sender?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué es una fuente? ¿Roadivo incluye canales?"
