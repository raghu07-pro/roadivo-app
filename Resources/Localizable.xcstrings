          "stringUnit" : {
            "state" : "translated",
            "value" : "कार में स्क्रीन नहीं है? अपना iPhone माउंट करें: लैंडस्केप, बड़े कंट्रोल, स्क्रीन हमेशा चालू।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno schermo in auto? Monta il tuo iPhone: orizzontale, controlli grandi, schermo sempre acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車の画面がない場合は、iPhone を固定してください。横向き表示、大きなコントロール、画面はスリープしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차량 화면이 없나요? iPhone을 거치하세요. 가로 모드, 큼직한 컨트롤, 화면 켜짐 유지."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem tela no carro? Prenda o iPhone num suporte: horizontal, controles grandes e tela sempre ligada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有车机屏幕？把 iPhone 固定在支架上：横屏显示、超大控件、屏幕保持常亮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沒有車機螢幕？將 iPhone 固定在支架上：橫向顯示、超大控制項目、螢幕保持開啟。"
          }
        }
      }
    },
