    "Search or type a website. A page's videos can go to your car with AirPlay, and direct video links play in Roadivo." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suche oder gib eine Website ein. Videos einer Seite kannst du per AirPlay ins Auto schicken, direkte Videolinks spielt Roadivo ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca o escribe un sitio web. Los vídeos de una página pueden ir al coche con AirPlay, y los enlaces directos a vídeo se reproducen en Roadivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherchez ou saisissez un site. Les vidéos d’une page peuvent passer sur la voiture avec AirPlay, et les liens vidéo directs se lisent dans Roadivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खोजें या वेबसाइट टाइप करें। पेज के वीडियो AirPlay से आपकी कार में जा सकते हैं, और सीधे वीडियो लिंक Roadivo में चलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca o digita un sito web. I video di una pagina possono andare in auto con AirPlay e i link diretti ai video si riproducono in Roadivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索するか、Webサイトを入力します。ページの動画はAirPlayで車に送れ、動画への直接リンクはRoadivoで再生できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검색하거나 웹 사이트를 입력하세요. 페이지의 동영상은 AirPlay로 차량에 보낼 수 있고, 동영상 직접 링크는 Roadivo에서 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busque ou digite um site. Os vídeos de uma página podem ir para o carro com AirPlay, e links diretos de vídeo são reproduzidos no Roadivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜索或输入网站。网页中的视频可通过 AirPlay 发送到车上，视频直链可在 Roadivo 中播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "搜尋或輸入網站。網頁中的影片可透過 AirPlay 傳送到車上，影片直接連結可在 Roadivo 中播放。"
          }
        }
      }
    },
    "Send video to an AirPlay car display, or mount your iPhone and switch on Car Mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sende Video an ein AirPlay-Autodisplay oder befestige dein iPhone und schalte den Automodus ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía vídeo a una pantalla de coche con AirPlay, o coloca tu iPhone en un soporte y activa el modo Coche."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez la vidéo vers un écran de voiture AirPlay, ou fixez votre iPhone sur un support et activez le mode Voiture."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay वाले कार डिस्प्ले पर वीडियो भेजें, या अपना iPhone माउंट करें और कार मोड चालू करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia il video a uno schermo per auto AirPlay, oppure monta il tuo iPhone e attiva la modalità Auto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay 対応の車載ディスプレイにビデオを送信するか、iPhone を固定してカーモードをオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AirPlay 지원 차량 디스플레이로 비디오를 보내거나, iPhone을 거치하고 차량 모드를 켜세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie vídeo para uma tela de carro com AirPlay, ou prenda o iPhone num suporte e ative o Modo Carro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将视频发送到支持 AirPlay 的车载显示屏，或把 iPhone 固定在支架上并打开车载模式。"
          }
        },
        "zh-Hant" : {
