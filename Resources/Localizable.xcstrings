    "Renews automatically; cancel anytime in Settings › Apple Account › Subscriptions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlängert sich automatisch; jederzeit kündbar unter „Einstellungen“ › „Apple Account“ › „Abonnements“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se renueva automáticamente; cancela cuando quieras en Ajustes › Cuenta de Apple › Suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renouvellement automatique ; résiliable à tout moment dans Réglages › Compte Apple › Abonnements."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने आप रिन्यू होता है; सेटिंग्ज़ › Apple खाता › सब्सक्रिप्शन में कभी भी रद्द करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rinnova automaticamente; disdici quando vuoi in Impostazioni › Account Apple › Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動的に更新されます。「設定」›「Apple アカウント」›「サブスクリプション」でいつでもキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 갱신됩니다. 설정 › Apple 계정 › 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renovação automática; cancele quando quiser em Ajustes › Conta Apple › Assinaturas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动续订；可随时在“设置” › “Apple 账户” › “订阅”中取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動續訂；可隨時在「設定」›「Apple 帳號」›「訂閱項目」中取消。"
          }
        }
      }
    },
