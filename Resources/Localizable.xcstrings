    "That doesn't look like a playlist link. Check it starts with http:// or https://." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nicht nach einem Playlist-Link aus. Prüfe, ob er mit http:// oder https:// beginnt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No parece un enlace de lista. Comprueba que empieza por http:// o https://."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ne ressemble pas à un lien de playlist. Vérifiez qu’il commence par http:// ou https://."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
