    "Pay once, keep forever. No subscription, no renewals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen, für immer behalten. Kein Abo, keine Verlängerungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez y es tuyo para siempre. Sin suscripción ni renovaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payez une fois, gardez-le pour toujours. Sans abonnement ni renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार भुगतान करें, हमेशा के लिए रखें। न सब्सक्रिप्शन, न रिन्यूअल।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi una volta, tuo per sempre. Nessun abbonamento, nessun rinnovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度の支払いでずっと使えます。サブスクリプションも更新もありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 결제로 영구 소장. 구독도 갱신도 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez e use para sempre. Sem assinatura, sem renovações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付费，永久拥有。无订阅，无续期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付費，永久擁有。無需訂閱，不會續訂。"
          }
        }
      }
    },
    "Personal and shared Plex servers only. Plex's own Live TV and Movies & Shows aren't included." : {
