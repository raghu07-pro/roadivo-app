    "System follows your iPhone's Light or Dark Mode setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der Einstellung „Hell“ oder „Dunkel“ deines iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema sigue el ajuste de modo claro u oscuro de tu iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Système suit le réglage Mode clair ou sombre de votre iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम आपके iPhone की लाइट या डार्क मोड सेटिंग के अनुसार चलता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue l'impostazione Chiaro o Scuro del tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システム」は iPhone のライト／ダークモード設定に合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템은 iPhone의 라이트 또는 다크 모드 설정을 따릅니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistema segue o ajuste de modo claro ou escuro do seu iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“跟随系统”会根据 iPhone 的浅色或深色模式设置显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「跟隨系統」會依照 iPhone 的淺色或深色模式設定顯示。"
          }
        }
      }
    },
    "Tap a source to see its channels. Swipe to delete, or touch and hold to refresh or rename." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Quelle, um ihre Kanäle zu sehen. Zum Löschen wischen, zum Aktualisieren oder Umbenennen gedrückt halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una fuente para ver sus canales. Desliza para eliminarla, o mantén pulsado para actualizarla o renombrarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une source pour voir ses chaînes. Balayez pour la supprimer, ou maintenez le doigt pour l’actualiser ou la renommer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी सोर्स के चैनल देखने के लिए उस पर टैप करें। डिलीट करने के लिए स्वाइप करें, या रीफ़्रेश या नाम बदलने के लिए दबाकर रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una sorgente per vederne i canali. Scorri per eliminarla, o tieni premuto per aggiornarla o rinominarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースをタップするとチャンネルが表示されます。スワイプで削除、長押しで更新または名前変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스를 탭하면 채널을 볼 수 있습니다. 쓸어서 삭제하거나, 길게 눌러 새로 고치거나 이름을 변경하십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma fonte para ver os canais. Deslize para apagar, ou toque e segure para atualizar ou renomear."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点来源可查看其频道。轻扫可删除，按住可更新或重新命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下來源可查看其頻道。滑動可刪除，按住可更新或重新命名。"
          }
        }
      }
    },
    "Tap Start Broadcast, then Start Broadcast again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Übertragung starten“ und dann noch einmal auf „Übertragung starten“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca «Iniciar transmisión» y, después, otra vez «Iniciar transmisión»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez « Commencer la diffusion », puis à nouveau « Commencer la diffusion »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्रॉडकास्ट शुरू करें पर टैप करें, फिर दोबारा ब्रॉडकास्ट शुरू करें पर टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Avvia trasmissione, poi di nuovo Avvia trasmissione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ブロードキャストを開始」をタップし、もう一度「ブロードキャストを開始」をタップします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "방송 시작을 탭한 다음 방송 시작을 다시 탭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Iniciar Transmissão e depois em Iniciar Transmissão de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点“开始直播”，然后再次轻点“开始直播”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點一下「開始直播」，然後再點一下「開始直播」。"
          }
        }
      }
    },
