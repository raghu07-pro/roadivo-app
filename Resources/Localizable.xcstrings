        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독 링크나 M3U 내용을 붙여넣거나, 스캔 아이콘을 탭하여 QR 코드를 읽으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
