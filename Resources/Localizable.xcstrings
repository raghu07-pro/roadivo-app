    "Used when no saved car or display is connected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt, wenn kein gesichertes Auto oder Display verbunden ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando no hay conectado ningún coche ni pantalla guardados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé quand aucune voiture ni aucun écran enregistrés ne sont connectés."
