    "Watch on the car's screen while parked, listen while you drive, or use a mounted iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau im Stand auf dem Bildschirm des Autos, hör während der Fahrt zu oder nutze ein befestigtes iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira en la pantalla del coche cuando esté aparcado, escucha mientras conduces o usa un iPhone en un soporte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regardez sur l’écran de la voiture à l’arrêt, écoutez en roulant, ou utilisez un iPhone fixé sur un support."
