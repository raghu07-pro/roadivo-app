    "Choose the car's display or adapter. iOS now shows your whole iPhone there, whatever app is open." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Display oder den Adapter des Autos. iOS zeigt dort jetzt dein ganzes iPhone, egal welche App offen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la pantalla o el adaptador del coche. iOS mostrará allí todo tu iPhone, sea cual sea la app abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’écran ou l’adaptateur de la voiture. iOS y affiche alors tout votre iPhone, quelle que soit l’app ouverte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कार का डिस्प्ले या अडैप्टर चुनें। अब iOS वहाँ आपका पूरा iPhone दिखाता है, चाहे कोई भी ऐप खुली हो।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli lo schermo o l’adattatore dell’auto. iOS ora mostra lì tutto il tuo iPhone, qualunque app sia aperta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車のディスプレイまたはアダプタを選択します。どのアプリを開いていても、iPhoneの画面全体がそこに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차량 디스플레이 또는 어댑터를 선택하세요. 이제 어떤 앱을 열든 iOS가 iPhone 화면 전체를 그곳에 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha a tela ou o adaptador do carro. O iOS passa a mostrar todo o seu iPhone ali, seja qual for o app aberto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择车辆的显示屏或适配器。无论打开哪个 App，iOS 都会在那里显示你的整个 iPhone 画面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇車輛的顯示器或轉接器。無論開啟哪個 App，iOS 都會在那裡顯示整個 iPhone 畫面。"
          }
        }
      }
    },
    "Choose what to watch from Favorites, Recent, Library or Browser." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
