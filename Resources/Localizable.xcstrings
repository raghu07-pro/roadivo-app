    "Video is off while driving. Sound keeps playing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während der Fahrt ist das Video aus. Der Ton läuft weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El vídeo se desactiva mientras conduces. El sonido sigue sonando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vidéo est coupée pendant la conduite. Le son continue."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गाड़ी चलाते समय वीडियो बंद रहता है। आवाज़ चलती रहती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il video è disattivato durante la guida. L’audio continua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転中はビデオがオフになります。音声は再生され続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운전 중에는 비디오가 꺼집니다. 소리는 계속 재생됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O vídeo fica desligado enquanto você dirige. O som continua tocando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驾驶时视频会关闭，声音继续播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "駕駛時影片會關閉，聲音繼續播放。"
          }
        }
      }
    },
    "Video on this page" : {
