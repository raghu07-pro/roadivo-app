    "Add an M3U link, file or QR code, or import videos from Photos and Files. Sorted automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen M3U-Link, eine Datei oder einen QR-Code hinzu oder importiere Videos aus Fotos und Dateien. Wird automatisch sortiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un enlace M3U, un archivo o un código QR, o importa vídeos desde Fotos y Archivos. Se ordenan automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un lien M3U, un fichier ou un code QR, ou importez des vidéos depuis Photos et Fichiers. Le tri est automatique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U लिंक, फ़ाइल या QR कोड जोड़ें, या फ़ोटो और फ़ाइलें से वीडियो इम्पोर्ट करें। सब अपने आप व्यवस्थित हो जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un link M3U, un file o un codice QR, oppure importa video da Foto e File. Ordinati automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U リンク、ファイル、QR コードを追加するか、写真やファイルからビデオを読み込みます。自動で整理されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "M3U 링크, 파일 또는 QR 코드를 추가하거나 사진 및 파일에서 비디오를 가져오세요. 자동으로 정리됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um link, arquivo ou código QR M3U, ou importe vídeos de Fotos e Arquivos. Tudo organizado automaticamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 M3U 链接、文件或QR 码，或从“照片”和“文件”导入视频。自动分类整理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 M3U 連結、檔案或 QR 碼，或從「照片」和「檔案」匯入影片。自動分類整理。"
          }
        }
      }
    },
