    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo verwendet die Kamera nur, um einen QR-Code mit einem Playlist-Link zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo uses the camera only to scan a QR code that contains a playlist link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo usa la cámara solo para escanear un código QR que contiene un enlace a una lista de reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo utilise l’appareil photo uniquement pour scanner un code QR contenant un lien de playlist."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo कैमरे का इस्तेमाल सिर्फ़ प्लेलिस्ट लिंक वाला QR कोड स्कैन करने के लिए करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo usa la fotocamera solo per scansionare un codice QR che contiene il link a una playlist."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo は、プレイリストのリンクを含む QR コードをスキャンするためにのみカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo는 재생목록 링크가 포함된 QR 코드를 스캔할 때만 카메라를 사용합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Roadivo usa a câmera apenas para ler um código QR que contém um link de playlist."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo 仅使用相机扫描包含播放列表链接的 QR 码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo 僅使用相機掃描包含播放列表連結的 QR 碼。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo verbindet sich mit Playlists und Videoservern in deinem lokalen Netzwerk, wenn du einen hinzufügst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo connects to playlists and video servers on your local network when you add one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo se conecta a listas de reproducción y servidores de vídeo de tu red local cuando añades uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo se connecte aux playlists et serveurs vidéo de votre réseau local lorsque vous en ajoutez un."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आप अपने लोकल नेटवर्क पर कोई प्लेलिस्ट या वीडियो सर्वर जोड़ते हैं, तो Roadivo उससे कनेक्ट होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo si connette a playlist e server video sulla tua rete locale quando ne aggiungi uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo は、ローカルネットワーク上のプレイリストやビデオサーバを追加したときに、それらに接続します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roadivo는 로컬 네트워크에 있는 재생목록 및 비디오 서버를 추가하면 해당 서버에 연결합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Roadivo se conecta a playlists e servidores de vídeo na sua rede local quando você adiciona um."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你添加本地网络上的播放列表或视频服务器时，Roadivo 会连接到它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你加入區域網路上的播放列表或影片伺服器時，Roadivo 會連線至它們。"
          }
        }
      }
    }
  },
  "version" : "1.0"
